---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPostDate, postUrl } from '../../lib/posts';
const posts = (await getCollection('posts')).toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Blog" interior>
  <article class="article">
    <p class="eyebrow">Blog</p>
    <h1>Ideas about software and people.</h1>
    <p>Writing, talks, and the occasional personal note. I think about design, software, and how we work together.</p>
    <ul class="posts-list" role="list">
      {posts.map((entry) => <li><a href={postUrl(entry)}>{entry.data.title}</a><time datetime={entry.data.date.toISOString()}>{formatPostDate(entry.data.date)}</time></li>)}
    </ul>
  </article>
</BaseLayout>
