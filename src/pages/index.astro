---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPostDate, postUrl } from '../lib/posts';

const posts = await getCollection('posts');
const recent = posts.toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <h1>Thoughtful systems for complex work.</h1>
    <p>Hello! I'm Adrianne (they/them), a staff software engineer in Portland, Oregon. I lead the Design Enablement team at <a href="https://www.honeycomb.io/">Honeycomb</a>, where I build design systems and frontend infrastructure.</p>
    <a href="mailto:me@adriannedaley.com">Get in touch</a>
  </section>
  <section class="section" aria-labelledby="recent-posts">
    <h2 class="section-title" id="recent-posts">Recent posts</h2>
    <ul class="posts-list" role="list">
      {recent.map((entry) => <li><a href={postUrl(entry)}>{entry.data.title}</a><time datetime={entry.data.date.toISOString()}>{formatPostDate(entry.data.date)}</time></li>)}
    </ul>
    <a href="/posts/">View all posts</a>
  </section>
</BaseLayout>
